  "item": [
    {
      "name": "Create new Customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('customer_id', jsonData.data.id);",
              "    pm.environment.set('customer_email', jsonData.data.email);",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const timestamp = new Date().getTime();",
              "pm.environment.set('unique_email', `test.customer.${timestamp}@digibank.com`);",
              "pm.environment.set('unique_phone', `+237${Math.floor(600000000 + Math.random() * 99999999)}`);",
              "pm.environment.set('unique_nationalid', `CNI${timestamp.toString().slice(-6)}`);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"fullName\": \"Test Customer\",\n    \"email\": \"{{unique_email}}\",\n    \"phoneNumber\": \"{{unique_phone}}\",\n    \"nationalId\": \"{{unique_nationalid}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers"
          ]
        }
      },
      "response": []
    },
    {
