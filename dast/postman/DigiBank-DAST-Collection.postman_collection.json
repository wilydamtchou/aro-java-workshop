  "item": [
    {
      "name": "Create new Customer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('customer_id', jsonData.data.id);",
              "    pm.environment.set('customer_email', jsonData.data.email);",
              "}",
              "",
              "pm.test(\"Customer created: status 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "pm.test(\"Customer has an id\", function () {",
              "    var j = pm.response.json();",
              "    pm.expect(j.data).to.be.an('object');",
              "    pm.expect(j.data.id).to.exist;",
              "});",
              "pm.test(\"Customer email matches the request\", function () {",
              "    var j = pm.response.json();",
              "    pm.expect(j.data.email).to.eql(pm.environment.get('unique_email'));",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const timestamp = new Date().getTime();",
              "pm.environment.set('unique_email', `test.customer.${timestamp}@digibank.com`);",
              "pm.environment.set('unique_phone', `+237${Math.floor(600000000 + Math.random() * 99999999)}`);",
              "pm.environment.set('unique_nationalid', `CNI${timestamp.toString().slice(-6)}`);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"fullName\": \"Test Customer\",\n    \"email\": \"{{unique_email}}\",\n    \"phoneNumber\": \"{{unique_phone}}\",\n    \"nationalId\": \"{{unique_nationalid}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/customers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Customers",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Customer found: status 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "pm.test(\"Returned id matches customer_id\", function () {",
              "    var j = pm.response.json();",
              "    pm.expect(String(j.data.id)).to.eql(String(pm.environment.get('customer_id')));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
