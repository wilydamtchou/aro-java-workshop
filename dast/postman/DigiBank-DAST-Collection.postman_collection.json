              "pm.test(\"Returned id matches customer_id\", function () {",
              "    var j = pm.response.json();",
              "    pm.expect(String(j.data.id)).to.eql(String(pm.environment.get('customer_id')));",
              "});",
              "",
              "pm.test(\"Returned email matches the created customer\", function () {",
              "    var j = pm.response.json();",
              "    pm.expect(j.data.email).to.eql(pm.environment.get('customer_email'));",
